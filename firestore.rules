rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny-all catch-all rule
    match /{document=**} {
      allow read, write: if false;
    }

    // Hardened Global Helpers
    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isClinicAdmin() {
      return isSignedIn() && (
        (request.auth.token.email == 'ashshifanaturalcare@gmail.com' && request.auth.token.email_verified == true) ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // Appointment validation helper
    function isValidAppointment(data) {
      return data.patientName is string && data.patientName.size() >= 2 && data.patientName.size() <= 100
        && data.patientPhone is string && data.patientPhone.size() >= 8 && data.patientPhone.size() <= 20
        && data.serviceId is string && data.serviceId.size() <= 64
        && data.date is string && data.date.size() <= 32
        && data.timeSlot is string && data.timeSlot.size() <= 32
        && (data.status in ['confirmed', 'pending', 'completed', 'cancelled'])
        && (!('notes' in data) || (data.notes is string && data.notes.size() <= 500))
        && (!('address' in data) || (data.address is string && data.address.size() <= 255));
    }

    // Review validation helper
    function isValidReview(data) {
      return data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.rating is number && data.rating >= 1 && data.rating <= 5
        && data.textEn is string && data.textEn.size() >= 5 && data.textEn.size() <= 1000;
    }

    // Collection: Appointments
    match /appointments/{appointmentId} {
      // Clinic staff/admin can list and get all; patients can read if they own the appointment or query by their own UID
      allow get: if isClinicAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);
      allow list: if isClinicAdmin() || (isSignedIn() && resource.data.userId == request.auth.uid);

      // Anyone (guest patient or logged-in patient) can book an appointment
      allow create: if isValidId(appointmentId) && isValidAppointment(incoming())
        && (!('userId' in incoming()) || incoming().userId == request.auth.uid);

      // Updates and cancellations by clinic admin or the owning patient
      allow update: if isClinicAdmin() || (
        isSignedIn() && existing().userId == request.auth.uid
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'notes', 'date', 'timeSlot'])
      );

      // Deletion restricted to clinic admins
      allow delete: if isClinicAdmin();
    }

    // Collection: Reviews
    match /reviews/{reviewId} {
      // Publicly readable for trust
      allow read: if true;

      // Any patient can submit an authentic review
      allow create: if isValidId(reviewId) && isValidReview(incoming());

      // Only clinic admin can moderate or delete reviews
      allow update, delete: if isClinicAdmin();
    }

    // Collection: Admins
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isClinicAdmin();
    }
  }
}
